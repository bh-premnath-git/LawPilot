{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.lawpilot.example/domain-event.v1.json",
  "title": "DomainEvent v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "specversion",
    "id",
    "source",
    "type",
    "time",
    "tenantId",
    "schemaVersion",
    "data"
  ],
  "properties": {
    "specversion": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "type": "string",
      "minLength": 1
    },
    "time": {
      "type": "string",
      "format": "date-time"
    },
    "tenantId": {
      "type": "string",
      "format": "uuid"
    },
    "schemaVersion": {
      "type": "string",
      "minLength": 1
    },
    "correlationId": {
      "type": "string"
    },
    "aggregateId": {
      "type": "string"
    },
    "data": {
      "type": "object"
    }
  }
}
