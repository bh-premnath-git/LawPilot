{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Normalized metadata-only DomainEvent v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "specversion",
    "id",
    "source",
    "type",
    "time",
    "tenantId",
    "schemaVersion",
    "correlationId",
    "causationId",
    "position",
    "data"
  ],
  "properties": {
    "specversion": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.]+\\.v1$"
    },
    "time": {
      "type": "string",
      "format": "date-time"
    },
    "tenantId": {
      "type": "string",
      "format": "uuid"
    },
    "schemaVersion": {
      "const": "1.0"
    },
    "correlationId": {
      "type": "string",
      "format": "uuid"
    },
    "causationId": {
      "type": "string",
      "format": "uuid"
    },
    "position": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        }
      ]
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "aggregateId",
        "aggregateType",
        "revision"
      ],
      "properties": {
        "aggregateId": {
          "type": "string",
          "format": "uuid"
        },
        "aggregateType": {
          "enum": [
            "document",
            "matter",
            "calendar",
            "ai_execution"
          ]
        },
        "revision": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$"
            }
          ]
        },
        "matterId": {
          "type": "string",
          "format": "uuid"
        }
      }
    }
  }
}
