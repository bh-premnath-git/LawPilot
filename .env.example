# ALL CREDENTIALS ARE LOCAL DEVELOPMENT PLACEHOLDERS — NEVER COPY TO PRODUCTION.
# Local development only. Keycloak image is pinned to 26.8.2 in compose.yaml.
NODE_ENV=development
# PostgreSQL 18 + pgvector 0.8.7 use a fresh pgdata18 volume; no PG16 migration.
POSTGRES_PASSWORD=local-dev-postgres-only
DATABASE_URL=postgresql://lawpilot_app:local-dev-app-only@localhost:5432/lawpilot
DATABASE_URL_DOCKER=postgresql://lawpilot_app:local-dev-app-only@postgres:5432/lawpilot
# Browser-visible issuer must exactly match the token iss claim.
# Use these localhost URLs when running the API directly on your machine.
KEYCLOAK_ISSUER=http://localhost:8080/realms/lawpilot-dev
KEYCLOAK_JWKS_URL=http://localhost:8080/realms/lawpilot-dev/protocol/openid-connect/certs
# Compose uses the internal keycloak hostname for JWKS; issuer stays localhost.
KEYCLOAK_JWKS_URL_DOCKER=http://keycloak:8080/realms/lawpilot-dev/protocol/openid-connect/certs
# Audience is mapped by lawpilot-web; permissions still require SQL grants.
KEYCLOAK_AUDIENCE=lawpilot-api
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=local-dev-keycloak-only
# Replace with a random secret of at least 32 characters before starting services.
# Example generator: openssl rand -hex 32
INTERNAL_HMAC_KEY=replace-with-long-random-local-dev-secret-32-characters-min
API_PORT=3000
SUPERVISOR_PORT=3001

# Legacy development HTTP fixture only; default AI transport uses gRPC below.
SUPERVISOR_URL=http://localhost:3001
SUPERVISOR_URL_DOCKER=http://root-supervisor:3001
AI_URL=http://localhost:8000
AI_URL_DOCKER=http://ai-capabilities:8000
PROVIDER_ROUTER_URL=http://localhost:8082
PROVIDER_ROUTER_URL_DOCKER=http://provider-router:8082
# Optional HTTP OTLP export for host-run API, supervisor and Python worker.
# Unset to disable export; Compose uses http://otel-collector:4318.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Durable executions: host-run Go worker and dispatcher (local development only).
WORKFLOW_DATABASE_URL=postgresql://lawpilot_workflow:local-dev-workflow-only@localhost:5432/lawpilot
DISPATCHER_DATABASE_URL=postgresql://lawpilot_dispatcher:local-dev-dispatcher-only@localhost:5432/lawpilot
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=lawpilot-executions-v1

# Generate first: bash scripts/generate_dev_tls.sh
# Set these to `id -u` and `id -g` so containers can read their private 0600 keys.
LOCAL_UID=1000
LOCAL_GID=1000
APP_ENV=development
CALENDAR_DATABASE_URL=postgresql://lawpilot_calendar:local-dev-calendar-only@localhost:5432/lawpilot
CALENDAR_GRPC_ADDRESS=localhost:50051
SUPERVISOR_GRPC_ADDRESS=localhost:50052
AI_GRPC_ADDRESS=localhost:50053
ENABLE_CALENDAR_REMINDERS=true
GRPC_CA_FILE=work/tls/ca.pem
# Host processes need their OWN workload identity (see docs/CALENDAR_GRPC.md).
# Example for API only; do not reuse api-gateway keys for workers or servers.
GRPC_CLIENT_CERT_FILE=work/tls/api-gateway.pem
GRPC_CLIENT_KEY_FILE=work/tls/api-gateway.key
# Set per server, e.g. calendar-service:
# GRPC_SERVER_CERT_FILE=work/tls/calendar-service.pem
# GRPC_SERVER_KEY_FILE=work/tls/calendar-service.key

# Secure context + general events (host processes; Compose sets internal URLs).
CONTEXT_DATABASE_URL=postgresql://lawpilot_context:local-dev-context-only@localhost:5432/lawpilot
EVENT_DATABASE_URL=postgresql://lawpilot_events:local-dev-events-only@localhost:5432/lawpilot
CONTEXT_GRPC_ADDRESS=localhost:50054
# Context server uses its OWN context-engine.pem/key plus GRPC_CA_FILE.
# Leave blank for explicit lexical-only retrieval. No synthetic production vectors.
# OpenAI-compatible /embeddings API, 1536-dimensional float output required.
# Example base URL format: https://your-approved-provider.example/v1
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
# Pin an operator-approved model revision; changing it creates a new profile.
EMBEDDING_REVISION=
EMBEDDING_API_KEY=

# Configured integrations: disabled until YOU supply real infrastructure/credentials.
# See docs/CONFIGURED_INTEGRATIONS.md for required grants and full setup.
INTEGRATION_DATABASE_URL=postgresql://lawpilot_integration:local-dev-integration-only@localhost:5432/lawpilot
INTEGRATION_GRPC_ADDRESS=localhost:50055
PARSER_GRPC_ADDRESS=localhost:50056
ENABLE_INTEGRATION_JOBS=true
FILE_STORAGE_ENABLED=false
# Private S3 bucket with all public-access blocks and default SSE-KMS encryption.
# Use the canonical KMS key ARN; encryption metadata must match it exactly.
S3_BUCKET=
S3_REGION=
S3_KMS_KEY_ID=
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
# Prefer workload IAM in production. Optional static credentials for local testing.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_SESSION_TOKEN=
S3_SKIP_BUCKET_POLICY_CHECK=false
# ClamAV INSTREAM; scanner failure blocks indexing. TLS required outside development.
CLAMAV_ADDRESS=
CLAMAV_CA_FILE=
CLAMAV_SERVER_NAME=
CLAMAV_CLIENT_CERT_FILE=
CLAMAV_CLIENT_KEY_FILE=
# Parser server uses document-parser.pem/key; integration uses integration-service.pem/key.
# Host-run parser only:
# DOCUMENT_PROCESSOR_BIN=/absolute/path/to/lawpilot-document-worker

CLIO_ENABLED=false
CLIO_REGION=us
CLIO_CLIENT_ID=
CLIO_CLIENT_SECRET=
CLIO_REDIRECT_URI=
# Required account IANA zone, e.g. Asia/Kolkata or America/New_York.
CLIO_TIME_ZONE=
# Optional Clio X-API-VERSION pin.
CLIO_API_VERSION=
GENERIC_PROVIDER_ENABLED=false
GENERIC_PROVIDER_BASE_URL=
GENERIC_PROVIDER_AUTHORIZE_URL=
GENERIC_PROVIDER_TOKEN_URL=
GENERIC_PROVIDER_CLIENT_ID=
GENERIC_PROVIDER_CLIENT_SECRET=
GENERIC_PROVIDER_REDIRECT_URI=
GENERIC_PROVIDER_TIME_ZONE=
GENERIC_PROVIDER_API_VERSION=
# Enables only approved conditional updates to EXISTING matter titles.
PROVIDER_WRITES_ENABLED=false
# AES-256-GCM token keyring JSON: {"active":"k1","keys":{"k1":"BASE64_32_BYTE_KEY"}}
# Generate a key with: openssl rand -base64 32. Keep old keys during rotation.
INTEGRATION_TOKEN_KEYS=
# Prefer a mounted file instead (service reads *_FILE before inline value):
# INTEGRATION_TOKEN_KEYS_FILE=/run/secrets/provider-token-keys.json

# Real model generation (OpenAI-compatible /chat/completions).
# All generated legal outputs require a distinct authorized attorney's approval.
LEGAL_AI_ENABLED=false
LEGAL_AI_BASE_URL=
LEGAL_AI_MODEL=
LEGAL_AI_REVISION=
LEGAL_AI_API_KEY=
LEGAL_AI_JSON_MODE=json_schema
LEGAL_AI_MAX_OUTPUT_TOKENS=2048
LEGAL_AI_MAX_PROMPT_BYTES=32768
# Default whole-document context is 16KiB/128 chunks; raise only with model budget.
CONTEXT_DOCUMENT_MAX_BYTES=

# Operations listener: internal only; do not publish without an authenticated proxy.
# Set per process; Go services expose /livez, /readyz and aggregate /metrics.
# OPS_ADDRESS=:9090
WORKLOAD_TRUST_DOMAIN=lawpilot.local
WORKLOAD_ALLOW_LEGACY_CN=false
# Production connections require sslmode=verify-full and a trusted DB root certificate.
# Dedicated admin/migration identity, never forwarded to runtime services:
MIGRATION_DATABASE_URL=
# TEMPORAL_TLS_ENABLED=true is REQUIRED with APP_ENV=production.
TEMPORAL_TLS_ENABLED=false
TEMPORAL_CA_FILE=
TEMPORAL_SERVER_NAME=
TEMPORAL_CLIENT_CERT_FILE=
TEMPORAL_CLIENT_KEY_FILE=
TEMPORAL_API_KEY=
# Secret-bearing Go settings also accept NAME_FILE (including DB URLs, API keys,
# provider client secrets, S3 credentials and the token keyring). Mount per service.
# Python accepts LEGAL_AI_API_KEY_FILE; API accepts DATABASE_URL_FILE.

# Provider expansion (all writes and webhook registration remain opt-in).
PROVIDER_WEBHOOKS_ENABLED=false
# Public HTTPS callback base, e.g. https://api.example/v1/provider-webhooks
PROVIDER_WEBHOOK_PUBLIC_URL=
PROVIDER_CALENDAR_WRITES_ENABLED=false
# Optional OCR runs only in the isolated parser, after malware scanning.
# off | empty-pages | all-pages. OCR is approximate and never verifies legal facts.
DOCUMENT_OCR_MODE=off
DOCUMENT_OCR_LANGUAGES=eng
DOCUMENT_OCR_MAX_PAGES=10
