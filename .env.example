# ALL CREDENTIALS ARE LOCAL DEVELOPMENT PLACEHOLDERS — NEVER COPY TO PRODUCTION.
# Local development only. Keycloak image is pinned to 26.8.2 in compose.yaml.
NODE_ENV=development
# PostgreSQL 18 + pgvector 0.8.7 use a fresh pgdata18 volume; no PG16 migration.
POSTGRES_PASSWORD=local-dev-postgres-only
DATABASE_URL=postgresql://lawpilot_app:local-dev-app-only@localhost:5432/lawpilot
DATABASE_URL_DOCKER=postgresql://lawpilot_app:local-dev-app-only@postgres:5432/lawpilot
# Browser-visible issuer must exactly match the token iss claim.
# Use these localhost URLs when running the API directly on your machine.
KEYCLOAK_ISSUER=http://localhost:8080/realms/lawpilot-dev
KEYCLOAK_JWKS_URL=http://localhost:8080/realms/lawpilot-dev/protocol/openid-connect/certs
# Compose uses the internal keycloak hostname for JWKS; issuer stays localhost.
KEYCLOAK_JWKS_URL_DOCKER=http://keycloak:8080/realms/lawpilot-dev/protocol/openid-connect/certs
# Audience is mapped by lawpilot-web; permissions still require SQL grants.
KEYCLOAK_AUDIENCE=lawpilot-api
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=local-dev-keycloak-only
# Replace with a random secret of at least 32 characters before starting services.
# Example generator: openssl rand -hex 32
INTERNAL_HMAC_KEY=replace-with-long-random-local-dev-secret-32-characters-min
API_PORT=3000
SUPERVISOR_PORT=3001

# Legacy development HTTP fixture only; default AI transport uses gRPC below.
SUPERVISOR_URL=http://localhost:3001
SUPERVISOR_URL_DOCKER=http://root-supervisor:3001
AI_URL=http://localhost:8000
AI_URL_DOCKER=http://ai-capabilities:8000
PROVIDER_ROUTER_URL=http://localhost:8082
PROVIDER_ROUTER_URL_DOCKER=http://provider-router:8082
# Optional HTTP OTLP export for host-run API, supervisor and Python worker.
# Unset to disable export; Compose uses http://otel-collector:4318.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Durable executions: host-run Go worker and dispatcher (local development only).
WORKFLOW_DATABASE_URL=postgresql://lawpilot_workflow:local-dev-workflow-only@localhost:5432/lawpilot
DISPATCHER_DATABASE_URL=postgresql://lawpilot_dispatcher:local-dev-dispatcher-only@localhost:5432/lawpilot
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=lawpilot-executions-v1

# Generate first: bash scripts/generate_dev_tls.sh
# Set these to `id -u` and `id -g` so containers can read their private 0600 keys.
LOCAL_UID=1000
LOCAL_GID=1000
APP_ENV=development
CALENDAR_DATABASE_URL=postgresql://lawpilot_calendar:local-dev-calendar-only@localhost:5432/lawpilot
CALENDAR_GRPC_ADDRESS=localhost:50051
SUPERVISOR_GRPC_ADDRESS=localhost:50052
AI_GRPC_ADDRESS=localhost:50053
ENABLE_CALENDAR_REMINDERS=true
GRPC_CA_FILE=work/tls/ca.pem
# Host processes need their OWN workload identity (see docs/CALENDAR_GRPC.md).
# Example for API only; do not reuse api-gateway keys for workers or servers.
GRPC_CLIENT_CERT_FILE=work/tls/api-gateway.pem
GRPC_CLIENT_KEY_FILE=work/tls/api-gateway.key
# Set per server, e.g. calendar-service:
# GRPC_SERVER_CERT_FILE=work/tls/calendar-service.pem
# GRPC_SERVER_KEY_FILE=work/tls/calendar-service.key

# Secure context + general events (host processes; Compose sets internal URLs).
CONTEXT_DATABASE_URL=postgresql://lawpilot_context:local-dev-context-only@localhost:5432/lawpilot
EVENT_DATABASE_URL=postgresql://lawpilot_events:local-dev-events-only@localhost:5432/lawpilot
CONTEXT_GRPC_ADDRESS=localhost:50054
# Context server uses its OWN context-engine.pem/key plus GRPC_CA_FILE.
# Leave blank for explicit lexical-only retrieval. No synthetic production vectors.
# OpenAI-compatible /embeddings API, 1536-dimensional float output required.
# Example base URL format: https://your-approved-provider.example/v1
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
# Pin an operator-approved model revision; changing it creates a new profile.
EMBEDDING_REVISION=
EMBEDDING_API_KEY=
